# Load test environment variables
# Copy this file to load-tests/.env and fill in values as needed.
# All variables have safe defaults for local development.
#
# Usage (PowerShell — set before running k6):
#   Get-Content load-tests/.env | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)=(.*)$') {
#       [System.Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim())
#     }
#   }
#
# Usage (k6 --env flag, no need to export):
#   k6 run --env BASE_URL=http://localhost:3000 --env LOAD_TARGET_RPS=10 load-tests/scenarios/load.js

# ---------------------------------------------------------------------------
# API target
# ---------------------------------------------------------------------------
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Smoke test
# ---------------------------------------------------------------------------
# Max milliseconds to wait for a job to reach "completed" or "failed".
# Increase if the worker or test transport is slow on your machine.
JOB_POLL_TIMEOUT_MS=30000

# How often to re-check during polling.
JOB_POLL_INTERVAL_MS=500

# ---------------------------------------------------------------------------
# Load test  (constant-arrival-rate)
# ---------------------------------------------------------------------------
# Target requests per second.  Start low and increase after establishing a baseline.
LOAD_TARGET_RPS=5

# How long to sustain the rate.  Use "30s", "1m", "2m", etc.
LOAD_DURATION=1m

# ---------------------------------------------------------------------------
# Stress test  (ramping-arrival-rate)
# ---------------------------------------------------------------------------
# Peak rate to reach at the top stage.  Stages automatically calculate 20%/50%/100%.
STRESS_MAX_RPS=20

# ---------------------------------------------------------------------------
# Soak test  (constant-arrival-rate, extended)
# ---------------------------------------------------------------------------
# Sustained rate — keep this LOW for local development (3–5 rps is fine).
SOAK_TARGET_RPS=3

# Duration of the soak.  "5m" is minimum useful; "30m" gives stronger signal.
SOAK_DURATION=5m

# ---------------------------------------------------------------------------
# Common generator ceiling
# ---------------------------------------------------------------------------
# Absolute maximum VUs k6 will allocate.  Prevents the generator from
# consuming all local resources.  Raise to 100+ only if you have a
# dedicated load-test machine.
MAX_VUS=50
